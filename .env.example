# Ithaca — Environment Variables
# Copy to .env and customize as needed.

# ─── App server ───
APP_BIND=127.0.0.1
APP_PORT=7860

# ─── Security ───
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-hex-string
AUTH_ENABLED=true

# ─── Database ───
DATABASE_URL=sqlite:///data/app.db

# ─── ChromaDB (vector memory) ───
# Leave empty for embedded mode (default). Set for server mode (Docker).
CHROMA_HOST=
CHROMA_PORT=8000

# ─── SearXNG (web search) ───
# Used by agent web_search tool and deep research.
SEARXNG_URL=http://localhost:8080

# ─── Notifications (ntfy) ───
NTFY_URL=http://localhost:8090
